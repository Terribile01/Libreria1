# GEMINI_API_KEY: Required for Gemini AI API calls and reading assistant.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPL_API_KEY: Optional key for DeepL translation of books and annotations.
DEEPL_API_KEY=""

# ELEVENLABS_API_KEY: Optional key for ElevenLabs high-quality text-to-speech.
ELEVENLABS_API_KEY=""

# GROQ_API_KEY: Required for Llama-3 models via Groq Cloud.
GROQ_API_KEY=""

# POLLINATIONS_API_KEY: Required for advanced image generation via Pollinations.ai.
POLLINATIONS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
